webserver:
  hosts:
    your-server.example.com:      # hostname or IP address of the target server
      ansible_user: ssh_username  # SSH user on the server (often differs from root)
  vars:
    ansible_ssh_private_key_file: ~/.ssh/id_rsa  # local path to the SSH private key
    # ansible_port: 22            # uncomment and change if the server uses a non-standard SSH port
